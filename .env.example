# Скопируйте в .env и заполните. .env в git не попадает (см. .gitignore).

# --- обязательно ---
# TELEGRAM_TOKEN: токен от @BotFather
TELEGRAM_TOKEN=
# ADMIN_USER_IDS: ваш Telegram ID; несколько -- через запятую. Пусто = бот молчит для всех
ADMIN_USER_IDS=

# --- данные (абсолютный путь надёжнее: относительный считается от cwd процесса) ---
AI_BASE_DIR=./data

# --- Ollama ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma2:latest
OLLAMA_EMBED_MODEL=bge-m3

# --- таймауты и лимиты ядра ---
# LLM_TIMEOUT: длинный вопрос + история + RAG не укладывается в 30 с (ADR-016)
LLM_TIMEOUT=90
JUDGE_TIMEOUT=15
MAX_REFLECTION_DEPTH=3
# MAX_STAGNATION_CYCLES: обязано быть: 1 <= MAX_STAGNATION_CYCLES < MAX_REFLECTION_DEPTH
MAX_STAGNATION_CYCLES=2
GPU_CONCURRENCY=1

# --- RAG и память ---
# OKO_COLLECTION: коллекция ChromaDB под OLLAMA_EMBED_MODEL; создаётся с метрикой cosine
OKO_COLLECTION=oko_knowledge_bge_m3
# OKO_RAG_MAX_DISTANCE: порог релевантности (ADR-006), шкала cosine
OKO_RAG_MAX_DISTANCE=0.48
# OKO_MEMORY_TTL_DAYS: 0 = автоудаление по сроку выключено (ADR-017)
OKO_MEMORY_TTL_DAYS=0

# --- алерты и опрос ---
ALERT_ERROR_THRESHOLD=0.15
ALERT_MIN_SAMPLE_SIZE=10
ALERT_CHECK_INTERVAL_S=60
STAGING_CHECK_INTERVAL_S=10

# --- «сон» M7: сводка лога и индекс дрейфа (только наблюдение, порогов нет) ---
# OKO_LOG_FILE: путь к логу OkoBot (файл AppStderr службы NSSM); пусто = сон выключен
OKO_LOG_FILE=
# SLEEP_IDLE_S: простой без сообщений админа, после которого возможен сон
SLEEP_IDLE_S=1200
# SLEEP_MIN_INTERVAL_S: не чаще одного раза в 6 ч (время берётся из data/ops.db)
SLEEP_MIN_INTERVAL_S=21600
SLEEP_CHECK_INTERVAL_S=300

# --- метрика S (векторный маркер): только наблюдение, порогов нет ---
# OKO_VECTOR_S: 0 = выключить; модель эмбеддингов = OLLAMA_EMBED_MODEL (bge-m3)
OKO_VECTOR_S=1

# --- process_watchdog.py (опционально) ---
WATCHDOG_MEMORY_LIMIT_MB=512
WATCHDOG_ERROR_RATE_LIMIT=5
WATCHDOG_ERROR_WINDOW_SEC=60
WATCHDOG_HEARTBEAT_TIMEOUT_SEC=120
WATCHDOG_CHECK_INTERVAL_SEC=10

# --- слой Σ (шлюз команд к устройствам; src/sigma_gate.py, src/tv_bot_handler.py) ---
# Читается из окружения процесса (переменные службы или .env через config.py). Пустое значение = умолчание кода.
# Пояснения -- отдельными строками: комментарий после пустого значения python-dotenv прочитал бы как значение.
# 1 = боевой шлюз (HALT / CLARIFY / OBSERVE не отправляют команду); иначе теневой режим: вердикт только в журнал.
OKO_SIGMA_LIVE=0
# 1 = вести теневой журнал команд ТВ (только запись, решения бота те же); иначе журнал и шлюз выключены.
OKO_SIGMA_SHADOW=0
# Путь журнала; пусто = logs/sigma_shadow.jsonl в корне проекта (путь во временной папке режима сбора отвергается).
OKO_SIGMA_SHADOW_PATH=
# Предел размера журнала в байтах; пусто = 5242880 (5 МиБ), при превышении -- ротация в <имя>.1.
OKO_SIGMA_SHADOW_MAX_BYTES=
# Файл состояния шлюза; пусто = sigma_state.json рядом с журналом (по умолчанию logs/sigma_state.json).
# Повреждён или не совпадает с параметрами -> HALT (fail-closed).
OKO_SIGMA_STATE_PATH=
# Файл параметров; пусто = config/sigma_params.json.
OKO_SIGMA_PARAMS_PATH=

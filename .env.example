# Скопируйте в .env и заполните. .env в git не попадает (см. .gitignore).

# --- обязательно ---
TELEGRAM_TOKEN=            # токен от @BotFather
ADMIN_USER_IDS=            # ваш Telegram ID; несколько -- через запятую. Пусто = бот молчит для всех

# --- данные (абсолютный путь надёжнее: относительный считается от cwd процесса) ---
AI_BASE_DIR=./data

# --- Ollama ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma2:latest
OLLAMA_EMBED_MODEL=bge-m3

# --- таймауты и лимиты ядра ---
LLM_TIMEOUT=90             # длинный вопрос + история + RAG не укладывается в 30 с (ADR-016)
JUDGE_TIMEOUT=15
MAX_REFLECTION_DEPTH=3
MAX_STAGNATION_CYCLES=2    # обязано быть: 1 <= MAX_STAGNATION_CYCLES < MAX_REFLECTION_DEPTH
GPU_CONCURRENCY=1

# --- RAG и память ---
OKO_COLLECTION=oko_knowledge_bge_m3  # коллекция ChromaDB под OLLAMA_EMBED_MODEL; создаётся с метрикой cosine
OKO_RAG_MAX_DISTANCE=0.48  # порог релевантности (ADR-006), шкала cosine
OKO_MEMORY_TTL_DAYS=0      # 0 = автоудаление по сроку выключено (ADR-017)

# --- алерты и опрос ---
ALERT_ERROR_THRESHOLD=0.15
ALERT_MIN_SAMPLE_SIZE=10
ALERT_CHECK_INTERVAL_S=60
STAGING_CHECK_INTERVAL_S=10

# --- «сон» M7: сводка лога и индекс дрейфа (только наблюдение, порогов нет) ---
OKO_LOG_FILE=              # путь к логу OkoBot (файл AppStderr службы NSSM); пусто = сон выключен
SLEEP_IDLE_S=1200          # простой без сообщений админа, после которого возможен сон
SLEEP_MIN_INTERVAL_S=21600 # не чаще одного раза в 6 ч (время берётся из data/ops.db)
SLEEP_CHECK_INTERVAL_S=300

# --- process_watchdog.py (опционально) ---
WATCHDOG_MEMORY_LIMIT_MB=512
WATCHDOG_ERROR_RATE_LIMIT=5
WATCHDOG_ERROR_WINDOW_SEC=60
WATCHDOG_HEARTBEAT_TIMEOUT_SEC=120
WATCHDOG_CHECK_INTERVAL_SEC=10
